#!/usr/bin/make -f
# Builds offline from the vendored crates in vendor/ (orig-vendor component
# tarball), with Ubuntu's versioned Rust toolchain.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export PATH := /usr/lib/rust-1.97/bin:$(PATH)
export CARGO_TERM_COLOR = never

CARGO_JOBS := $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
CARGO_FLAGS := --release --offline --frozen $(if $(CARGO_JOBS),-j$(CARGO_JOBS))

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "%s/vendor"\n' '$(CURDIR)' > $(CARGO_HOME)/config.toml
	cargo --version
	rustc --version

override_dh_auto_build:
	cargo build $(CARGO_FLAGS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test $(CARGO_FLAGS)
endif

override_dh_auto_install:
	install -Dm0755 target/release/seeker debian/seeker/usr/bin/seeker
	install -Dm0644 data/io.github.ElectricStars.Seeker.desktop \
		debian/seeker/usr/share/applications/io.github.ElectricStars.Seeker.desktop
	install -Dm0644 data/io.github.ElectricStars.Seeker.svg \
		debian/seeker/usr/share/icons/hicolor/scalable/apps/io.github.ElectricStars.Seeker.svg
	install -Dm0644 data/io.github.ElectricStars.Seeker.metainfo.xml \
		debian/seeker/usr/share/metainfo/io.github.ElectricStars.Seeker.metainfo.xml

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but vendored crates ship some (Cargo.toml.orig,
# protocol files) and cargo verifies them against .cargo-checksum.json.
override_dh_clean:
	dh_clean -Xvendor/
