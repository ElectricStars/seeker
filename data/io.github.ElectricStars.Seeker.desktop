[Desktop Entry]
Type=Application
Name=Seeker
GenericName=File Search
Comment=Find files by name and by text inside them
Exec=seeker %F
Icon=io.github.ElectricStars.Seeker
Terminal=false
Categories=Utility;FileTools;
Keywords=search;find;grep;files;text;regex;
StartupWMClass=io.github.ElectricStars.Seeker
StartupNotify=true
